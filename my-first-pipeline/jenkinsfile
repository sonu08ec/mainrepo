pipeline {
    agent any

    stages {
        stage('Check Docker') {
            steps {
                bat 'docker --version'
            }
        }

        stage('Pull Node Image') {
            steps {
                bat 'docker pull node:16-alpine'
            }
        }

        stage('Run Node') {
            steps {
                bat 'docker run --rm node:16-alpine node --version'
            }
        }
    }
}
