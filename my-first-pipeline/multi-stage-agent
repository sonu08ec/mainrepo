pipeline {
    agent any

    stages {

        stage('Back-end') {
            steps {
                bat 'docker pull maven:3.8.1-adoptopenjdk-11'
                bat 'docker run --rm maven:3.8.1-adoptopenjdk-11 mvn --version'
            }
        }

        stage('Front-end') {
            steps {
                bat 'docker pull node:16-alpine'
                bat 'docker run --rm node:16-alpine node --version'
            }
        }

    }
}
